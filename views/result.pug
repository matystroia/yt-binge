doctype html
html(lang="en")
  head
    title= 'YouTube Binge'
    link(rel='stylesheet', href='css/style.css')
    link(rel='stylesheet', href='https://fonts.googleapis.com/css?family=Montserrat:300, 700')
    script(type='text/javascript').
  body
    .container
      if duration
        p.result
          | It would take
          br
          span.time= duration
          br
          | to watch all of
          |
          span.title= channelTitle
          | 's 
          a(href=uploadsUrl) videos
          | .
          br
          if trivia
            br
            | That's about the same as 
            span= trivia
            | .
      if error
        p.error= error
      br
      a(href='/') Back
